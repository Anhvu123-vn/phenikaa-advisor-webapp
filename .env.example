# Bắt buộc đổi thành chuỗi ngẫu nhiên dài trước khi public.
PHENIKAA_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# HTTP trực tiếp qua IP: 0
# Sau khi đã cấu hình HTTPS/domain: đổi thành 1
PHENIKAA_COOKIE_SECURE=0

# Tự điền tài khoản ở trang đăng nhập Microsoft (không bao giờ điền mật khẩu).
# Cách 1: email đầy đủ
# PHENIKAA_QLDT_EMAIL=mssv@st.phenikaa-uni.edu.vn
# Cách 2: chỉ MSSV (domain mặc định st.phenikaa-uni.edu.vn, đổi bằng biến dưới nếu cần)
# PHENIKAA_QLDT_MSSV=
# PHENIKAA_QLDT_EMAIL_DOMAIN=st.phenikaa-uni.edu.vn
